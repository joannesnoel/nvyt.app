# Application
APP_URL=http://localhost:3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://nvyt:nvyt@localhost:5432/nvyt

# Redis
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# PayMongo (https://developers.paymongo.com/)
PAYMONGO_PUBLIC_KEY=pk_test_xxx
PAYMONGO_SECRET_KEY=sk_test_xxx
PAYMONGO_WEBHOOK_SECRET=whsk_xxx

# Email - SMTP (Mailtrap for development - https://mailtrap.io/)
# Get credentials from: Mailtrap > Email Testing > Inboxes > SMTP Settings
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=a940a446401db8
SMTP_PASS=5b6b41b28d8aeb
SMTP_FROM=nvyt <noreply@nvyt.app>

# Email - API (Resend for production - https://resend.com/)
# If SMTP_HOST is set, it takes priority over Resend
RESEND_API_KEY=re_xxx

# Google Maps (https://console.cloud.google.com/apis/credentials)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Pusher (https://pusher.com/)
PUSHER_APP_ID=your-pusher-app-id
PUSHER_KEY=your-pusher-key
PUSHER_SECRET=your-pusher-secret
PUSHER_CLUSTER=ap1

# S3 Storage (MinIO for development, Garage for production)
# These defaults work with docker-compose.dev.yml
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=nvyt-uploads
S3_PUBLIC_URL=http://localhost:9000/nvyt-uploads
