# Application
APP_URL=http://localhost:3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://nvyt:nvyt@localhost:5432/nvyt

# Redis
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# PayMongo (https://developers.paymongo.com/)
PAYMONGO_PUBLIC_KEY=pk_test_xxx
PAYMONGO_SECRET_KEY=sk_test_xxx

# Email - SMTP (Mailtrap for development - https://mailtrap.io/)
# Get credentials from: Mailtrap > Email Testing > Inboxes > SMTP Settings
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your-mailtrap-user
SMTP_PASS=your-mailtrap-password
SMTP_FROM=nvyt <noreply@nvyt.app>

# Email - API (Resend for production - https://resend.com/)
# If SMTP_HOST is set, it takes priority over Resend
RESEND_API_KEY=re_xxx

# Google Maps (https://console.cloud.google.com/apis/credentials)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
