# Ultra-lightweight migration using Alpine + psql only
FROM alpine:3.19

# Install only PostgreSQL client
RUN apk add --no-cache postgresql-client bash

WORKDIR /app

# Copy migration files
COPY packages/db/drizzle/*.sql ./migrations/
COPY packages/db/drizzle/meta/_journal.json ./migrations/meta/

# Copy migration script
COPY docker/run-migrations.sh ./

RUN chmod +x run-migrations.sh

CMD ["./run-migrations.sh"]
