# Terraform Variables for nvyt.app Production
# Copy this file to terraform.tfvars and fill in your values
# IMPORTANT: terraform.tfvars should be gitignored

# AWS Configuration
aws_region  = "ap-southeast-1"
aws_profile = "nvyt-prod"

# Project
project_name = "nvyt"
environment  = "production"

# Domain
domain_name = "nvyt.app"

# Application URL
app_url = "https://nvyt.app"

# Admin emails (comma-separated)
admin_emails = "admin@example.com"

# PayMongo (get from PayMongo dashboard)
paymongo_public_key     = "pk_live_xxx"
paymongo_secret_key     = "sk_live_xxx"
paymongo_webhook_secret  = "whsk_xxx"
paymongo_payment_methods = "qrph"

# Google Maps
google_maps_api_key = "AIzaSy..."

# Pusher (for real-time features)
pusher_app_id  = "your-app-id"
pusher_key     = "your-key"
pusher_secret  = "your-secret"
pusher_cluster = "ap1"

# PayPal (get from PayPal Developer Dashboard)
paypal_client_id     = "your-client-id"
paypal_client_secret = "your-client-secret"
paypal_mode          = "live"  # or "sandbox" for testing
paypal_webhook_id    = "your-webhook-id"

# Sentry (error tracking)
sentry_dsn = "https://examplePublicKey@o0.ingest.sentry.io/0"

# SMTP (for sending emails)
smtp_host = "smtp.example.com"
smtp_port = "587"
smtp_user = "your-smtp-user"
smtp_pass = "your-smtp-password"
smtp_from = "nvyt <noreply@nvyt.app>"

# Cron job authentication
cron_secret = "your-cron-secret"

# Web Push (VAPID) - generate with: npx web-push generate-vapid-keys
vapid_public_key  = "your-vapid-public-key"
vapid_private_key = "your-vapid-private-key"

# Database (optional - defaults are fine for most cases)
# db_instance_class    = "db.t3.micro"
# db_allocated_storage = 20

# ECS (optional - defaults are fine for most cases)
# ecs_task_cpu     = 512
# ecs_task_memory  = 1024
# ecs_desired_count = 2
