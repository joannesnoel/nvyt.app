{
  "name": "nvyt",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "db:generate": "pnpm --filter @nvyt/db db:generate",
    "db:migrate": "pnpm --filter @nvyt/db db:migrate",
    "db:studio": "pnpm --filter @nvyt/db db:studio",
    "reset:dev": "npx tsx scripts/reset-dev.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "dotenv": "^16.4.7",
    "postgres": "^3.4.5",
    "tsx": "^4.19.2",
    "turbo": "^2.3.0",
    "typescript": "^5.7.2"
  }
}
